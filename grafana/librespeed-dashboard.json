{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operations view for speed, latency, test health, freshness, and transfer volume. KPI counts and byte totals are rounded estimates: Prometheus increase() extrapolates at range edges, and rounding can differ from actual test totals. Byte totals include successful tests only; counter history is unavailable before exporter rollout. Counter KPIs need two samples per selected configured server. Tests completed before the first scrape after startup or restart may be missed.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Servers tested in the selected range compared with the configured server inventory. Tested appears only after two samples per selected configured server; a missing value does not mean zero tests. Tests completed before the first scrape after startup or restart may be missed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#DA70D6" },
          "decimals": 0,
          "noValue": "No tests in range",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 16,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "(count(sum by (server_id) (increase(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"}) > 0) or vector(0)) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "legendFormat": "Tested",
          "refId": "A"
        },
        {
          "expr": "count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"}))",
          "instant": true,
          "legendFormat": "Configured",
          "refId": "B"
        }
      ],
      "title": "Servers used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rounded estimates of attempts, successes, and failures in the selected range. Prometheus increase() extrapolates at range edges. Values require two samples per selected configured server. Tests completed before the first scrape after startup or restart may be missed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#DA70D6" },
          "decimals": 0,
          "noValue": "Waiting for counter samples",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failed" },
            "properties": [
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 17,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "round(sum(increase(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"})) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "legendFormat": "Attempts",
          "refId": "A"
        },
        {
          "expr": "round(sum(increase(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"})) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "legendFormat": "Succeeded",
          "refId": "B"
        },
        {
          "expr": "round(sum(increase(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"})) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "legendFormat": "Failed",
          "refId": "C"
        }
      ],
      "title": "Tests in range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Successful tests divided by attempts in the selected range. No value appears when the range has zero attempts or fewer than two samples per selected configured server. Tests completed before the first scrape after startup or restart may be missed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "noValue": "No tests in range",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "(100 * sum(increase(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"}) / sum(increase(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"})) and (sum(increase(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"}) > 0) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Success rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rounded estimate of bytes sent by successful tests in the selected range; increase() extrapolates at range edges. Pre-deployment counter history is unavailable. Values require two samples per selected configured server. Tests completed before the first scrape after startup or restart may be missed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "decimals": 0,
          "noValue": "Waiting for counter samples",
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "id": 19,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "round(sum(increase(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"})) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Data uploaded",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rounded estimate of bytes received by successful tests in the selected range; increase() extrapolates at range edges. Pre-deployment counter history is unavailable. Values require two samples per selected configured server. Tests completed before the first scrape after startup or restart may be missed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "decimals": 0,
          "noValue": "Waiting for counter samples",
          "unit": "bytes"
        },
        "overrides": []
