    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Prometheus samples the latest successful measurements. Failed tests retain stale values; check attempt status and success age.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
