      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "round(sum(increase(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) and on(server_id) librespeed_test_success{server_id=~\"$server_id\"})) and on() (count(count by (server_id) (count_over_time(librespeed_test_attempts_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_successes_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_test_failures_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_sent_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (count_over_time(librespeed_bytes_received_total{server_id=~\"$server_id\"}[$__range]) >= 2) and on(server_id) count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})) == count(count by (server_id) (librespeed_test_success{server_id=~\"$server_id\"})))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Data downloaded",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Fixed 0–1 Gbps scale. Value is from the latest successful test.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "max": 1000000000,
          "min": 0,
          "noValue": "No successful test",
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 5 },
      "id": 1,
      "options": {
        "barShape": "rounded",
        "barWidthFactor": 0.54,
        "effects": { "barGlow": false, "centerGlow": false, "gradient": true },
        "endpointMarker": "point",
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "segmentCount": 1,
        "segmentSpacing": 0.3,
        "shape": "gauge",
        "showThresholdLabels": false,
        "showThresholdMarkers": false,
        "sizing": "auto",
        "sparkline": true,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "librespeed_download_bits_per_second{server_id=~\"$server_id\"} and on(server_id) (librespeed_test_last_success_timestamp_seconds{server_id=~\"$server_id\"} > 0)",
          "refId": "A"
        }
      ],
      "title": "Download speed",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Fixed 0–1 Gbps scale. Value is from the latest successful test.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "max": 1000000000,
          "min": 0,
          "noValue": "No successful test",
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 5 },
      "id": 2,
      "options": {
        "barShape": "rounded",
        "barWidthFactor": 0.54,
        "effects": { "barGlow": false, "centerGlow": false, "gradient": true },
        "endpointMarker": "point",
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "segmentCount": 1,
        "segmentSpacing": 0.3,
        "shape": "gauge",
        "showThresholdLabels": false,
        "showThresholdMarkers": false,
        "sizing": "auto",
        "sparkline": true,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "librespeed_upload_bits_per_second{server_id=~\"$server_id\"} and on(server_id) (librespeed_test_last_success_timestamp_seconds{server_id=~\"$server_id\"} > 0)",
          "refId": "A"
        }
      ],
      "title": "Upload speed",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Lower is better. Color bands are visual guidance, not an SLO.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "noValue": "No successful test",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 75 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 5 },
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 100,
        "minVizHeight": 24,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "textMode": "value_and_name",
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "(librespeed_ping_seconds{server_id=~\"$server_id\"} * 1000) and on(server_id) (librespeed_test_last_success_timestamp_seconds{server_id=~\"$server_id\"} > 0)",
          "legendFormat": "ping {{server_id}}",
          "refId": "A"
        }
      ],
      "title": "Ping latency — lower is better",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
